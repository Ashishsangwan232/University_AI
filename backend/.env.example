# Saved chats: one SQLite file, created automatically. No database server needed.
DATABASE_URL=sqlite:///data/campusai.db
# General LPU facts the bot answers from. Edit the file and restart to update.
UNIVERSITY_INFO_FILE=data/university_info.md
FRONTEND_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------ AI model
# Which model answers by default: ollama, gemini or openai. All drive exactly the same
# tools, so this only changes who writes the sentences - never what data is
# available or how anything is calculated.
AGENT_PROVIDER=ollama
# Try the other provider when the chosen one fails or has no key.
AGENT_FALLBACK=true
# How many tool-calling rounds one question may take.
AGENT_MAX_TOOL_ROUNDS=5

# Ollama Cloud. Get a key from https://ollama.com -> Settings -> API keys.
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_API_KEY=your_ollama_api_key
OLLAMA_TIMEOUT_SECONDS=120
# To use a local Ollama instead, no key needed:
#   OLLAMA_BASE_URL=http://localhost:11434
#   OLLAMA_MODEL=gpt-oss:120b-cloud     (or any model you have pulled)

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# OpenAI. Appears in the model menu once OPENAI_API_KEY is set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------ chat memory
# Conversations are saved in the SQLite file above, so a chat survives a reload and the
# assistant remembers what you already said instead of asking again.
# Recent turns go to the model verbatim; older ones are compressed once into
# the thread's summary, so a long chat does not get slower every message.
CHAT_HISTORY_MESSAGES=12
CHAT_HISTORY_CHARACTER_BUDGET=8000
CHAT_SUMMARY_AFTER_MESSAGES=14
CHAT_MAX_CONVERSATIONS=50

# ---------------------------------------------------------------- UMS session
# Playwright-only. No extension, no bridge, no token. The student signs in and
# completes verification by hand; CampusAI never reads or stores credentials.
# Hostname used to identify the UMS tab. Tab order is never trusted.
# Dedicated profile - never the student's normal Chrome profile.
UMS_URL=https://ums.lpu.in/lpuums/
UMS_HOST=ums.lpu.in
UMS_BROWSER_PROFILE=data/ums/playwright-chrome-profile
UMS_CDP_PORT=9222

# Candidate attendance pages, tried in order only if no in-portal "Attendance"
# link can be clicked. Every attempt is logged and shown in /api/ums/diagnostics.
UMS_ATTENDANCE_PATHS=
# Controls clicked to LOAD an attendance panel that has no URL of its own.
# LPU UMS renders its attendance table into a modal only after the dashboard
# tile #AttPercent calls getAtt() - before that click no table exists in the DOM.
UMS_ATTENDANCE_OPENERS=#AttPercent,[onclick*='getAtt']
# Close the panel again once the table has been read.
UMS_CLOSE_AFTER_CAPTURE=true
# Collapsibles holding the per-course class log in the attendance modal's second
# tab: #collapseCSE329, #collapseINT373 and so on.
UMS_ATTENDANCE_DETAIL_SELECTOR=[id^=collapse]

# --- Announcements & messages ------------------------------------------------
# Containers holding the cards, from the site map: #tAC is the announcement
# centre and #tAM its "mine" tab; #MyMessage is the dashboard message panel and
# #divMessage / #exampleModalRight the "All Messages" modal. Each DIRECT CHILD of
# a container is treated as one card. If extraction comes back empty or wrong,
# run scripts/ums_inspect.py and point these at the right element.
UMS_ANNOUNCEMENT_CONTAINERS=#tAC,#tAM
UMS_ANNOUNCEMENT_OPENERS=#AnnouncementLink
UMS_ANNOUNCEMENT_PAGE=frmHistoryAnnouncemnt.aspx
UMS_MESSAGE_CONTAINERS=#MyMessage,#divMessage,#exampleModalRight .modal-body
UMS_MESSAGE_OPENERS=#MyMessageLink,[onclick*='getMyAllMessages']
UMS_MESSAGE_PAGE=frmStudentsMyMessages.aspx
# A card with more title elements than this wraps many items rather than being
# one; announcement rows hold 1, message rows 2, the All Messages modal dozens.
UMS_CARD_MAX_TITLE_ELEMENTS=4
# Timetable. frmMyCurrentTimeTable.aspx ships empty and fills #timetable by AJAX
# when GetTimeTableData1() runs. Reports/frmStudentTimeTable.aspx is an SSRS
# ReportViewer that errors out on this portal, so it is deliberately not used.
UMS_TIMETABLE_PAGE=frmMyCurrentTimeTable.aspx
UMS_TIMETABLE_OPENERS=[onclick*='GetTimeTableData1'],#timetable-tab
UMS_TIMETABLE_CONTAINER=#timetable
UMS_TIMETABLE_WAIT_SECONDS=3.0
# Hostel leave. READ ONLY: CampusAI opens this page with a GET and reads the
UMS_LEAVE_PAGE=frmStudentHostelLeaveApplicationTermWise.aspx
UMS_LEAVE_WAIT_SECONDS=2.5
# balances and authorities. It never fills the form, ticks the acknowledgement,
# or clicks Submit, and there is no setting that turns that on.

# Prefill types a validated draft into the UMS leave form. OFF by default.
# Even when on it fills only the five labelled fields below and stops: the
# acknowledgement is never ticked and Submit is never clicked. Prefill is also
# deliberately NOT a Gemini tool - the model drafts, a person presses the button.
UMS_ALLOW_PREFILL=false
UMS_LEAVE_TYPE_LABEL=Leave Type
UMS_LEAVE_START_LABEL=Start Date & Time of Leave
UMS_LEAVE_END_LABEL=Leave Ending Date Time
UMS_LEAVE_PLACE_LABEL=Visit place
UMS_LEAVE_REASON_LABEL=Reason of Leaving
UMS_LEAVE_DATETIME_FORMAT=%d/%m/%Y %H:%M
UMS_PANEL_MAX_ITEMS=60
UMS_PANEL_MAX_LINES=20
# How the date fields expect a value. If UMS reformats or rejects what is typed,
# the read-back will show it and this is the one setting to change.
# Two of these (or an explicit logout control) must be present before the
# session counts as authenticated.
UMS_DASHBOARD_MARKERS=student dashboard,my academics,attendance,logout,student support,academic

UMS_AUTO_NAVIGATE=true
# Retries of automatic capture before CampusAI waits for an explicit Refresh.
UMS_AUTO_CAPTURE_ATTEMPTS=3

# Words that disqualify a control even though it says "attendance" - this is what
# Menu labels clicked to reveal a hidden attendance control.
# keeps Playwright off event/QR attendance, biometric marking, and correction forms.
UMS_ATTENDANCE_BLOCK_WORDS=event,qr,scan,mark attendance,biometric,face,regulari,correction,request,apply
UMS_MENU_KEYWORDS=academic,my academics,attendance,course,student,menu
UMS_EXPAND_MENUS=true
UMS_MIN_CANDIDATE_SCORE=1
UMS_MAX_CANDIDATE_CLICKS=5
UMS_MAX_MENU_CLICKS=3
UMS_REMEMBER_TARGET=true
UMS_MONITOR_INTERVAL_SECONDS=2.0
UMS_TABLE_WAIT_SECONDS=25
UMS_CAPTURE_TIMEOUT_SECONDS=90

# --- Prefetch & memory cache -------------------------------------------------
# Right after you sign in, CampusAI reads everything below in the background so
# chat answers come from memory instead of waiting on UMS. Memory only - cleared
# on Disconnect or when UMS shows its login page again.
UMS_PREFETCH=true
UMS_PREFETCH_ITEMS=attendance,profile,timetable,announcements,messages,leave,attendance_detail
# Re-read an item in the background once it is this old (0 = only once).
# Each re-read drives the UMS window, so keep it modest.
UMS_REFRESH_AFTER_SECONDS=900
# Answers use cached data up to this old; older data is read on the spot.
UMS_CACHE_MAX_AGE_SECONDS=3600
UMS_PREFETCH_RETRY_SECONDS=120
# Remember the control that worked in data/ums/attendance_target.json.
# Only URLs and a CSS path are stored - never cookies, tokens, or page content.


# Optional explicit browser paths (Windows)
# CAMPUSAI_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# CAMPUSAI_EDGE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
